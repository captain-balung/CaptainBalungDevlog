# Copy this file to `.env.local` and fill in the values from Supabase.
# `.env.local` is gitignored; this `.example` file is the shared template.

# Supabase Project URL — Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable (anon) key — Settings → API keys
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase secret (service_role) key — Settings → API keys
# Server-side only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
